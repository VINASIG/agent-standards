{
  "name": "@vinasig/agent-standards",
  "version": "0.1.0",
  "private": true,
  "description": "Portable VINASIG SI agent policies, skills and verified project integration",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VINASIG/agent-standards.git"
  },
  "homepage": "https://github.com/VINASIG/agent-standards#readme",
  "bugs": {
    "url": "https://github.com/VINASIG/agent-standards/issues"
  },
  "keywords": [
    "vinasig",
    "si-agents",
    "codex",
    "agent-standards"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:metadata": "node scripts/check-metadata.ts",
    "check": "npm run typecheck && npm run lint && npm run check:metadata && npm run format:check",
    "test": "node --test tests/*.test.ts",
    "test:web": "playwright test -c tests/playwright.config.ts",
    "test:performance": "node scripts/measure-performance.ts",
    "demo": "node scripts/demo.ts",
    "eval:codex": "node scripts/eval-codex.ts",
    "standards": "node dist/cli.js",
    "bundle": "node dist/bundle.js",
    "verify:quality": "node scripts/verify-quality.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "html-validate": "11.16.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  }
}
